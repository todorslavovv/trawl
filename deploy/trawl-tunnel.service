[Unit]
Description=Cloudflare Quick Tunnel (trycloudflare.com) -> trawl web on 127.0.0.1:8790
Documentation=https://developers.cloudflare.com/cloudflare-one/networks/connectors/cloudflare-tunnel/do-more-with-tunnels/trycloudflare/
After=trawl-web.service network-online.target
# Wants, not Requires: restarting the web service on a deploy must not restart the
# tunnel, because every Quick Tunnel restart issues a new public hostname.
Wants=trawl-web.service

[Service]
# Quick Tunnel for demonstration only - a new random hostname on every start.
# --no-autoupdate: a service is not an interactive terminal, so cloudflared would
# otherwise update itself and exit (this killed the old osint tunnel on 2026-09-25).
ExecStart=%h/bin/cloudflared tunnel --no-autoupdate --url http://127.0.0.1:8790
Restart=on-failure
RestartSec=10
UMask=0077
# Sandboxing (verified to start under the SteamOS user manager). cloudflared needs
# outbound network only; it writes nothing to disk in Quick Tunnel mode.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=default.target
